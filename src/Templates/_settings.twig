{# @var plugin \ContentReactor\Dynex\Plugin #}
{# @var settings \ContentReactor\Dynex\Models\Settings #}

{% import '_includes/forms.twig' as forms %}

{{ forms.textField({
	first: true,
	label: 'Plugin Name'|t('dynex'),
	instructions: 'How the plugin is labeled in the control panel, including the main menu. Leave blank to use the default name.'|t('dynex'),
	id: 'pluginName',
	name: 'pluginName',
	value: settings.pluginName,
	placeholder: plugin.defaultName,
	errors: settings.getErrors('pluginName'),
}) }}

{{ forms.textField({
	label: 'Keep Export Runs For'|t('dynex'),
	instructions: 'How many days export runs and their files are kept. Enter 0 to keep them until they’re deleted.'|t('dynex'),
	tip: plugin.isPro() ? null : plugin.proMessage('Export runs'|t('dynex'), plugin.pluginName),
	id: 'exportRetentionDays',
	name: 'exportRetentionDays',
	type: 'number',
	min: 0,
	size: 5,
	value: settings.exportRetentionDays,
	errors: settings.getErrors('exportRetentionDays'),
}) }}
